---
import Layout from '../../../../layouts/Generic.astro';
import Costs from '../../../../components/seasons/ArenaCost.astro';
---

<Layout title='Realm Protector - Mob Arena - Season #6 - Pixel Craft - Pixel Series' backPage='/pixel-craft/season-6/mob-arena/' id='EZ9Kn' slug='PCS6-MA-Realm-Protector'>
  <div class="row justify-content-center">
    <h1 class="primary-title">Pixel Craft Season #6</h1>
  </div>
  <div class="col justify-content-center">
    <div class="col info text-center">
      <h2>Realm Protector Fight</h2>
      <p>To initiate the Realm Protector fright follow these requirements.<br/>The Mob Arena is located at the back of the Unlock Isles.</p>
      <div class="col justify-content-center">
        <img class="mob" src="/images/pixel-craft/season-6/mob-arena/realm-protector/fight.png" alt="An image of the Realm Protector.">
        <h3>Fight Cost</h3>
        <div class="row justify-content-center">
          <Costs name='Sacrifical Livestock'>
            <li>20x Pig</li>
          </Costs>
          <Costs name='Caged Entities'>
            <li>Cell 1 | Zombie</li>
            <li>Cell 2 | Zombie</li>
            <li>Cell 3 | Zombie</li>
            <li>Cell 4 | Zombie</li>
            <li>Cell 5 | Zombie</li>
            <li>Cell 6 | Zombie</li>
            <li>Cell 7 | Zombie</li>
            <li>Cell 8 | Zombie</li>
            <li>Cell 9 | Zombie</li>
            <li>Cell 10 | Zombie</li>
            <li>Cell 11 | Zombie</li>
            <li>Cell 12 | Zombie</li>
            <li>Cell 13 | Zombie</li>
            <li>Cell 14 | Zombie</li>
            <li>Cell 15 | Zombie</li>
            <li>Cell 16 | Zombie</li>
            <li>Cell 17 | Zombie</li>
            <li>Cell 18 | Zombie</li>
            <li>Cell 19 | Zombie</li>
            <li>Cell 20 | Zombie</li>
            <li>Cell 21 | Zombie</li>
            <li>Cell 22 | Zombie</li>
          </Costs>
          <Costs name='Other Criteria'>
            <li>Time of Day | Night</li>
            <li>Lunar Event | Harvest</li>
          </Costs>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .primary-title {
    border: 3px;
    border-color: lightslategray;
    border-style: groove;
    border-radius: 25px;
    padding: 10px;
    background: rgba(51, 51, 51, 0.5);
  }
  .info {
    border: 3px;
    border-color: lightslategray;
    border-style: inset;
    border-radius: 25px;
    font-size: large;
    padding: 10px;
    margin: 5px;
    background: rgba(51, 51, 51, 0.5);
  }
  .info:last-child {
    margin-bottom: 3em;
  }

.mob {
  width: auto;
  height: 50%;
  border: 3px;
  border-style: double;
  border-color: gray;
  border-radius: 33px;
}
</style>