---
import Layout from '../../../../layouts/Generic.astro';
import Costs from '../../../../components/seasons/BuildCost.astro';
---

<Layout title='Big Ruined Portal - Build Plates - Season #6 - Pixel Craft - Pixel Series' backPage='/pixel-craft/season-6/build-plates/' id='dybJN' slug='PCS6-BP-Big-Ruined-Portal'>
  <div class="row justify-content-center">
    <h1 class="primary-title">Pixel Craft Season #6</h1>
  </div>
  <div class="col justify-content-center">
    <div class="col info text-center">
      <h2>Big Ruined Portal Build Plate</h2>
      <p>To create the Big Ruined Portal item.<br/>This build will need to be built in side of the Build Plate on the Unlock Isles.</p>
      <div class="col justify-content-center">
        <img id="UseTheBaseLink" title="TDRKRVNuR3p5YkJremRqNg==" class="build" src="/images/pixel-craft/season-6/build-plates/big-ruined-portal/build.png" alt="An image of the build to make the Big Ruined Portal.">
        <h3>Build Cost</h3>
        <div class="row justify-content-center">
          <Costs>
            <li>Time of Day | Night</li>
            <li>Lunar Event | Any</li>
          </Costs>
          <Costs>
            <li>1x Chest</li>
            <li>2x Block of Gold</li>
            <li>4x Chiseled Stone Bricks</li>
            <li>11x Lava Bucket</li>
            <li>18x Iron Bars</li>
            <li>20x Stone Brick Stairs</li>
            <li>31x Obsidian</li>
            <li>39x Stone Brick Slab</li>
            <li>63x Stone Bricks</li>
            <li>293x Netherrack</li>
          </Costs>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .primary-title {
    border: 3px;
    border-color: lightslategray;
    border-style: groove;
    border-radius: 25px;
    padding: 10px;
    background: rgba(51, 51, 51, 0.5);
  }
  .info {
    border: 3px;
    border-color: lightslategray;
    border-style: inset;
    border-radius: 25px;
    font-size: large;
    padding: 10px;
    margin: 5px;
    background: rgba(51, 51, 51, 0.5);
  }
  .info:last-child {
    margin-bottom: 3em;
  }

.build {
  width: 50%;
  height: auto;
  border: 3px;
  border-style: double;
  border-color: gray;
  border-radius: 33px;
}
</style>